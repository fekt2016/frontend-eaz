# API base URL (use full URL when not using same-origin proxy)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Paystack public key for inline JS (optional)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# Production site URL (used for canonical URLs, metadataBase, and sitemap)
NEXT_PUBLIC_SITE_URL=https://www.eazworld.co
