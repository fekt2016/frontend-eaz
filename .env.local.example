# ─── Copy this file to .env.local and fill in real values ────────────────
# .env.local is gitignored — never commit real secrets.

# API base URL (use full URL when not using same-origin proxy)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Login/session secret. MUST be identical to the backend JWT_SECRET — the
# Next.js middleware uses it to verify auth cookies. Server-only (no
# NEXT_PUBLIC_ prefix) so it is never exposed to the browser.
# Generate a strong value with:  openssl rand -hex 32
JWT_SECRET=generate-with-openssl-rand-hex-32

# Frontend site URL — single source of truth for canonical URLs, metadataBase,
# Open Graph URLs, sitemap, and robots. REQUIRED in production: src/lib/seo.js
# throws (failing the build) rather than silently emitting localhost URLs.
# The container must supply it at BOTH image-build time and run time — the
# sitemap and robots routes can render per-request, not just at build.
FRONTEND_URL=http://localhost:3000

# Paystack public key for inline JS (optional)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# cPanel SSO target shown to customers (avoid a bare IP in production).
NEXT_PUBLIC_CPANEL_URL=https://your-cpanel-host:2083
# cPanel SSO: omit or "false" = same-tab redirect after /cpanel-login; "true" = new tab
# NEXT_PUBLIC_CPANEL_OPEN_IN_NEW_TAB=false

# Bank transfer details (shown on the bank-transfer checkout page)
NEXT_PUBLIC_BANK_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NAME=
NEXT_PUBLIC_BANK_ACCOUNT_NUMBER=
NEXT_PUBLIC_BANK_BRANCH=

# Nameservers customers point their domains at
NEXT_PUBLIC_NAMESERVER_1=ns1.eazworld.co
NEXT_PUBLIC_NAMESERVER_2=ns2.eazworld.co
