# API base URL (use full URL when not using same-origin proxy)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Must match backend JWT_SECRET — Next.js middleware uses this to verify auth tokens
# (server-only, no NEXT_PUBLIC_ prefix — never expose this to the browser)
JWT_SECRET=your-jwt-secret-here

# Paystack public key for inline JS (optional)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# cPanel SSO: omit or "false" = same-tab redirect after /cpanel-login; "true" = new tab
# NEXT_PUBLIC_CPANEL_OPEN_IN_NEW_TAB=false
